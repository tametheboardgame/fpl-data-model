{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FPL qualitative scouting observation",
  "type": "object",
  "required": [
    "observation_id",
    "observed_at",
    "recorded_at",
    "observer",
    "raw_note",
    "confidence"
  ],
  "anyOf": [
    {"required": ["player_id"]},
    {"required": ["player_code"]}
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "observer": {"type": "string", "minLength": 1},
    "season": {"type": "string"},
    "gameweek": {"type": ["integer", "null"]},
    "fixture_id": {"type": ["integer", "null"]},
    "player_id": {"type": ["integer", "null"]},
    "player_code": {"type": ["integer", "null"]},
    "player_name": {"type": ["string", "null"]},
    "source_type": {"type": "string"},
    "raw_note": {"type": "string", "minLength": 1},
    "retracts_observation_id": {"type": ["string", "null"]},
    "attacking_role": {"type": "number", "minimum": -2, "maximum": 2},
    "movement_sharpness": {"type": "number", "minimum": -2, "maximum": 2},
    "fitness_energy": {"type": "number", "minimum": -2, "maximum": 2},
    "minutes_security": {"type": "number", "minimum": -2, "maximum": 2},
    "set_piece_role": {"type": "number", "minimum": -2, "maximum": 2},
    "team_reliance": {"type": "number", "minimum": -2, "maximum": 2},
    "tactical_fit": {"type": "number", "minimum": -2, "maximum": 2},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["active", "retracted"]}
  },
  "additionalProperties": true
}
